APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_ADMIN_MAIL=admin@example.com
APP_ADMIN_PASS=asd123
APP_CONTACT_MAIL="contact@mail.com"

LOG_CHANNEL=stack

DOCKER_DOMAIN=${APP_NAME}
DOCKER_AUTHOR=majkipl
DOCKER_HTTPD_PORT=8130
DOCKER_MYSQL_PORT=8131
DOCKER_PHPMYADMIN_PORT=8132
DOCKER_MAILCATCHER_SMTP=8137
DOCKER_MAILCATCHER_WEB=8138

DB_CONNECTION=mysql
DB_HOST=${DOCKER_DOMAIN}-mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_ROOTPASSWORD=root_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=${DOCKER_DOMAIN}-mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=
